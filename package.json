{
  "name": "jellyseerr-mcp-modern",
  "version": "1.0.0",
  "description": "Jellyseerr MCP server with stdio, SSE, and Streamable HTTP transports.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "start": "node dist/index.js",
